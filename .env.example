# Plantilla: completar secretos SOLO en el servidor, nunca en Git.
#   cp .env.example .env && chmod 600 .env
#
# Este archivo no contiene secretos reales. El servidor genera sus propios valores.
# Para usar un archivo externo: export BIOMETRIC_ENV_FILE=/etc/sipe-biometric/runtime.env

# ---------------------------------------------------------------------------
# Publicación del servicio
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Dispositivo biométrico (ZKTeco / pyzk)
# ---------------------------------------------------------------------------
BIOMETRIC_HOST=192.168.30.90
BIOMETRIC_PORT=4370
# Clave de comunicación del equipo. Vacía o 0 si el equipo no la exige.
BIOMETRIC_PASSWORD=
BIOMETRIC_TIMEOUT=10
BIOMETRIC_DEVICE_ID=alcaldia-central
# auto | tcp | udp
BIOMETRIC_TRANSPORT=tcp
BIOMETRIC_ENCODING=UTF-8

# ---------------------------------------------------------------------------
# Autenticación de la API
# ---------------------------------------------------------------------------
# OBLIGATORIO: generar en el servidor.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Mínimo 32 caracteres. Se envía como: Authorization: Bearer <token>
BIOMETRIC_API_TOKEN=CAMBIAR_EN_SERVIDOR

# ---------------------------------------------------------------------------
# Paginación de /attendance
# ---------------------------------------------------------------------------
ATTENDANCE_DEFAULT_LIMIT=500
ATTENDANCE_MAX_LIMIT=5000

# ---------------------------------------------------------------------------
# Servicio y publicación
# ---------------------------------------------------------------------------
APP_ENV=qa
LOG_LEVEL=INFO
# Publica /docs y /openapi.json. Dejar en false si la API queda expuesta.
BIOMETRIC_ENABLE_DOCS=false

# Puerto local publicado del servicio. Es el destino de Cloudflare Tunnel.
# Nunca se abre en el router.
BIOMETRIC_API_PORT=8200

# Nombre del contenedor (sólo si convive con otra instancia en el mismo host).
BIOMETRIC_CONTAINER=sipe_biometric_api
